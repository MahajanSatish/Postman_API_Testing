				{
					"name": "Get Booking Ids Details",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {\r",
									"    pm.response.to.have.status(200);\r",
									"});\r",
									"\r",
									"var jsonData = pm.response.json();\r",
									"pm.test(\"Verify First name\", function () {\r",
									"    pm.expect(jsonData.firstname).to.eql(\"Parth\");\r",
									"});\r",
									"pm.test(\"Verify Last name\", function () {\r",
									"    pm.expect(jsonData.lastname).to.eql(\"Mahajan\");\r",
									"});\r",
									"\r",
									"pm.test(\"Verify totalprice \", function () {\r",
									"    pm.expect(jsonData.totalprice).to.eql(123);\r",
									"});\r",
									"\r",
									"pm.test(\"Verify Check in date\", function () {\r",
									"    var jsonData = pm.response.json();\r",
									"    pm.expect(jsonData.bookingdates.checkin).to.eql(\"2026-01-01\");\r",
									"});\r",
									"\r",
									"pm.test(\"Verify Checkout in date\", function () {\r",
									"    var jsonData = pm.response.json();\r",
									"    pm.expect(jsonData.bookingdates.checkout).to.eql(\"2026-01-02\");\r",
									"});\r",
									"\r",
									"\r",
									"const expectedJsonSchema =\r",
									"{ \r",
									"  \"type\": \"object\",\r",
									"  \"properties\": {\r",
									"    \"firstname\": {\r",
									"      \"type\": \"string\"\r",
									"    },\r",
									"    \"lastname\": {\r",
									"      \"type\": \"string\"\r",
									"    },\r",
									"    \"totalprice\": {\r",
									"      \"type\": \"integer\"\r",
									"    },\r",
									"    \"depositpaid\": {\r",
									"      \"type\": \"boolean\"\r",
									"    },\r",
									"    \"bookingdates\": {\r",
									"      \"type\": \"object\",\r",
									"      \"properties\": {\r",
									"        \"checkin\": {\r",
									"          \"type\": \"string\"\r",
									"        },\r",
									"        \"checkout\": {\r",
									"          \"type\": \"string\"\r",
									"        }\r",
									"      },\r",
									"      \"required\": [\r",
									"        \"checkin\",\r",
									"        \"checkout\"\r",
									"      ]\r",
									"    },\r",
									"    \"additionalneeds\": {\r",
									"      \"type\": \"string\"\r",
									"    }\r",
									"  },\r",
									"  \"required\": [\r",
									"    \"firstname\",\r",
									"    \"lastname\",\r",
									"    \"totalprice\",\r",
									"    \"depositpaid\",\r",
									"    \"bookingdates\",\r",
									"    \"additionalneeds\"\r",
									"  ]\r",
									"}\r",
									"pm.test(\"Verify JSON schema\", function () {\r",
									"    pm.response.to.have.jsonSchema(expectedJsonSchema);\r",
									"}\r",
									")"
								],
								"type": "text/javascript",
